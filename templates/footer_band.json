{
  "id": "footer_band",
  "name": "Dải chân trang",
  "description": "Dải màu thương hiệu phủ ~44% phía dưới, logo dạng viên thuốc + tên, caption in hoa ở giữa, từ nhấn màu vàng. Giữ khung gốc.",
  "canvas": "source",
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0.56,
      "w": 1,
      "h": 0.44,
      "fill": "$primary",
      "fill_to": "$primary_dark",
      "direction": "vertical",
      "radius": 0,
      "stroke": null,
      "stroke_width": 0
    },
    {
      "type": "logo",
      "x": 0.05,
      "y": 0.595,
      "h": 0.08,
      "anchor": "left",
      "label": "$name",
      "weight": "Black",
      "color": "#FFFFFF",
      "gap": 0.012,
      "pill": {
        "fill": "$pill",
        "stroke": "$pill_stroke",
        "stroke_width": 0.003,
        "pad": 0.012,
        "radius": "full"
      }
    },
    {
      "type": "caption",
      "box": {
        "x": 0.06,
        "y": 0.70,
        "w": 0.88,
        "h": 0.25
      },
      "weight": "Black",
      "uppercase": true,
      "color": "$text",
      "accent": "$accent",
      "align": "center",
      "valign": "middle",
      "max_size": 0.075,
      "min_size": 0.032,
      "line_spacing": 1.18,
      "max_lines": 4,
      "shadow": {
        "color": "#00000088",
        "dx": 0.004,
        "dy": 0.005,
        "blur": 0.002
      },
      "stroke": {
        "color": "#000000",
        "width": 0.003
      }
    }
  ]
}
