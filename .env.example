# ==============================================================================
# TAIO Cover Studio - Biến môi trường mẫu (.env.example)
# Sao chép tệp này thành .env và điền các khóa cấu hình cần thiết.
# ==============================================================================

# Cấu hình cổng và máy chủ
PORT=8765
HOST=127.0.0.1

# Bảo vệ bằng mật khẩu (Để trống APP_PASSWORD nếu không muốn khoá)
APP_USER=taio
APP_PASSWORD=

# Nhà cung cấp AI mặc định (claude | gemini | openai | openrouter | ollama)
DEFAULT_AI_PROVIDER=gemini

# Khóa API AI (Chỉ cần điền nhà cung cấp bạn sử dụng)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Giới hạn dung lượng tệp tải lên (MB) - Khuyên dùng 300MB trên Render Free
MAX_UPLOAD_MB=300

# Số lượng video xuất song song tối đa (mặc định 1 để tiết kiệm RAM/CPU)
MAX_PARALLEL_RENDERS=1

# Giới hạn số luồng ffmpeg (mặc định 2 để RAM không vượt 512MB trên Render)
FFMPEG_THREADS=2

# Tốc độ mã hóa ffmpeg (ultrafast, superfast, veryfast, faster, fast, medium)
FFMPEG_PRESET=veryfast

# Giới hạn cạnh ngắn độ phân giải video xuất (720 tối ưu cho Render Free)
OUTPUT_MAX_RES=720

# Tự động dọn dẹp tệp tải lên và tệp xuất sau X giờ (0 = tắt tự dọn dẹp)
FILE_TTL_HOURS=6

# Thư mục lưu trữ workspace
WORKSPACE_DIR=./workspace
